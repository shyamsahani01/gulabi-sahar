extends Node3D

var skeleton: Skeleton3D
var model: Node3D
var hero_scene: PackedScene = preload("res://assets/characters/shyam_hero_v09.glb")
var time := 0.0
var movement_speed := 0.0
var grounded := true
var talking := false
var action := ""
var action_left := 0.0
var guarding := false
var crouching := false
var animation_tree: AnimationTree
var locomotion_blend := 0.0
var variant := 0
var crowd := false
var kind := "adult"
var legacy_model := true
# MakeHuman (MPFB, CC0) crowd variants generated by tools/build_crowd.py; the old single
# crowd mesh is the fallback when a variant file is missing.
const CROWD_MODELS := {
	"adult": ["man_shirt_01", "woman_kurti_01", "man_kurta_01", "woman_dress_01", "man_shirt_02", "woman_kurti_02"],
	"child": ["boy_01", "girl_01", "boy_02"],
	"elder": ["old_man_01", "old_woman_01"],
}

func crowd_model_path() -> String:
	var names: Array = CROWD_MODELS.get(kind, CROWD_MODELS["adult"])
	var candidate: String = "res://assets/characters/crowd/" + str(names[variant % names.size()]) + ".glb"
	if ResourceLoader.exists(candidate):
		return candidate
	return "res://assets/characters/crowd_walk.glb"
var animator: AnimationPlayer
var look: LookAtModifier3D
var action_next := ""
# Physical layer (hero_physics.gd): ragdoll for knockdowns, foot IK, dangling wardrobe.
var ragdoll: PhysicalBoneSimulator3D
var ragdolling := false
var ragdoll_time := 0.0
var foot_ik: Dictionary = {}
var pendulums: Array = []
# Real motion-capture clips (CMU database, retargeted by tools/cmu_retarget.py) replace the
# hand-keyed action clips of the same name; these loop, these need fists.
const MOCAP_LOOPS := ["JumpAir", "Guard", "Crouch", "Sit", "SitHigh", "Talk", "Listen", "Fidget"]
const MOCAP_FISTS := ["Jab", "Cross", "Kick", "Guard"]
var outfit := 0
var wardrobe_nodes: Array = []
var stubble: MeshInstance3D
var stubble_material: ShaderMaterial
var look_target: Node3D
var look_path := NodePath()
static var shared_library: AnimationLibrary
var bones: Dictionary = {}
var face: MeshInstance3D
var expression := "Neutral"
var expression_time := 0.0
var blink_clock := 1.8
var blink_phase := -1.0
var brow_flash := 0.0
# Real eyeballs (v09): the gaze is steered by sliding the iris texture a little on the sphere,
# which gives saccades and look-at without an eye bone.
var eye_material: StandardMaterial3D
var eye_base_uv := Vector3.ZERO
var gaze := Vector2.ZERO
var gaze_target := Vector2.ZERO
var gaze_clock := 0.6
const EXPRESSIONS := ["Neutral", "Smile", "Serious", "Surprised"]
# Blend-shape targets per expression. Smile carries its own cheek lift and lower-lid squint
# (built in tools/refine_hero_v08.py); the eyebrows ride on separate BrowRaise/BrowFurrow keys.
const EXPRESSION_SHAPES := {
	"Neutral": {},
	"Smile": {"Smile": 1.0, "BrowRaise": 0.22},
	"Serious": {"Serious": 1.0, "BrowFurrow": 0.85},
	"Surprised": {"Surprised": 1.0, "BrowRaise": 1.0},
}

func set_expression(value: String, duration: float = 5.0) -> void:
	if value in EXPRESSIONS:
		if value == "Smile" and expression != "Smile":
			# A real smile starts with the brows: they lift first, then settle while the mouth widens.
			brow_flash = 1.0
		expression = value
		expression_time = duration

func face_targets() -> Dictionary:
	var targets: Dictionary = EXPRESSION_SHAPES.get(expression, {}).duplicate()
	if expression == "Smile":
		targets["BrowRaise"] = targets["BrowRaise"] + 0.38 * brow_flash
	if talking:
		# Conversational brow movement: small lifts on the stressed beats of speech.
		var beat := maxf(0.0, sin(time * 3.4) + 0.35 * sin(time * 7.1))
		targets["BrowRaise"] = maxf(targets.get("BrowRaise", 0.0), 0.1 + 0.22 * beat)
	return targets

func update_gaze(delta: float) -> void:
	if eye_material == null:
		return
	gaze_clock -= delta
	if gaze_clock <= 0:
		# Saccade: a quick jump to a new fixation, mostly near the centre, occasionally wider.
		gaze_clock = randf_range(0.5, 2.6)
		var wide := randf() < 0.25
		gaze_target = Vector2(randf_range(-1, 1), randf_range(-0.6, 0.6)) * (0.022 if wide else 0.009)
	var aim := gaze_target
	if look != null and look.influence > 0.3 and look_target != null and is_instance_valid(look_target):
		# Eyes lead the head toward whoever we are looking at.
		var local := skeleton.to_local(look_target.global_position) - skeleton.get_bone_global_pose(skeleton.find_bone("head")).origin
		aim += Vector2(clampf(-local.x * 0.03, -0.02, 0.02), clampf(local.y * 0.015, -0.012, 0.012))
	# Saccades are fast (~40 ms); smooth pursuit is slower.
	gaze = gaze.move_toward(aim, delta * (0.6 if gaze.distance_to(aim) > 0.004 else 0.12))
	eye_material.uv1_offset = eye_base_uv + Vector3(gaze.x, gaze.y, 0)

func cycle_expression() -> void:
	set_expression(EXPRESSIONS[(EXPRESSIONS.find(expression) + 1) % EXPRESSIONS.size()], 3600.0)

func update_face(delta: float) -> void:
	if face == null:
		return
	expression_time = maxf(0, expression_time - delta)
	if expression_time == 0:
		expression = "Serious" if movement_speed > 4 else "Neutral"
	blink_clock -= delta
	if blink_clock <= 0 and blink_phase < 0:
		blink_phase = 0
		blink_clock = randf_range(2.8, 5.5)
	var blink := 0.0
	if blink_phase >= 0:
		blink_phase += delta
		blink = sin(clampf(blink_phase / 0.18, 0, 1) * PI)
		if blink_phase >= 0.18:
			blink_phase = -1
	brow_flash = move_toward(brow_flash, 0.0, delta * 1.4)
	update_gaze(delta)
	var targets := face_targets()
	for i in range(face.mesh.get_blend_shape_count()):
		var shape := str(face.mesh.get_blend_shape_name(i))
		var target: float = blink if shape.begins_with("Blink") else float(targets.get(shape, 0.0))
		# Lids snap, brows are quick, the mouth and cheeks take about a third of a second.
		var speed := 14.0 if shape.begins_with("Blink") else (7.0 if shape.begins_with("Brow") else 4.5)
		face.set_blend_shape_value(i, move_toward(face.get_blend_shape_value(i), target, delta * speed))

func _ready() -> void:
	var scene: PackedScene = hero_scene
	legacy_model = true
	if crowd:
		var path := crowd_model_path()
		legacy_model = path == "res://assets/characters/crowd_walk.glb"
		scene = load(path)
	model = scene.instantiate()
	model.rotation.y = PI
	# Children and elders reuse the crowd rig at a different scale until dedicated models exist.
	if kind == "child":
		model.scale = Vector3(0.62, 0.62, 0.62)
	elif kind == "elder":
		model.scale = Vector3(0.95, 0.95, 0.95)
	add_child(model)
	skeleton = model.find_children("*", "Skeleton3D", true, false)[0]
	# Shared animation tracks address the skeleton as "Shyam_rig".
	if skeleton.name != "Shyam_rig":
		skeleton.name = "Shyam_rig"
	for i in range(skeleton.get_bone_count()):
		var name_key := skeleton.get_bone_name(i)
		bones[name_key] = i
	if not legacy_model:
		polish_generated_materials()
	var shirts := [Color("b5a482"), Color("759591"), Color("b57965"), Color("657b97"), Color("d0bfa2"), Color("8f857b")]
	var trousers := [Color("29383f"), Color("4c4540"), Color("343a4e")]
	if kind == "child":
		shirts = [Color("d9a441"), Color("c94f4f"), Color("4f8fc9"), Color("5fa565"), Color("d97ba8"), Color("f0e4c2")]
		trousers = [Color("3a4e7a"), Color("6b4a3a"), Color("2f2f2f")]
	elif kind == "elder":
		shirts = [Color("efe8d6"), Color("e3d9c3"), Color("d8d2c2")]
		trousers = [Color("e9e3d4"), Color("4c4540"), Color("d9d2c1")]
	for mesh in model.find_children("*", "MeshInstance3D", true, false):
		if not crowd and mesh.mesh.get_blend_shape_count() > 0 and (face == null or mesh.name.begins_with("HeroFace")):
			face = mesh
		mesh.visibility_range_end = 55
		mesh.visibility_range_end_margin = 3
		if not legacy_model:
			continue
		for surface in range(mesh.mesh.get_surface_count()):
			var original = mesh.get_active_material(surface)
			if not original is StandardMaterial3D:
				continue
			var mat: StandardMaterial3D = original.duplicate()
			mat.metallic = 0.0
			mat.metallic_specular = 0.15
			mat.roughness = 0.85
			if mesh.name.begins_with("HeroFace_Continuous"):
				# Slightly tighter highlights so the sculpted brow, nose and cheekbones read in-game.
				mat.roughness = .62
				mat.metallic_specular = .3
			elif mesh.name.begins_with("HeroHair"):
				mat.roughness = .58
				mat.metallic_specular = .25
			if mesh.name.begins_with("HeroEyelashes"):
				mat.roughness = 0.65
				mat.metallic_specular = 0.1
			elif mesh.name.begins_with("HeroEye"):
				# Wet cornea: tight highlight, a slightly darker brown iris, and the material is
				# kept so the gaze can move (the iris texture slides on the sphere).
				mat.roughness = 0.1
				mat.metallic_specular = 0.6
				eye_material = mat
				eye_base_uv = mat.uv1_offset
			# The closed body mesh culls back faces so the lid and mouth shells never show through
			# the skin; garments and the hair cap stay double-sided.
			mat.cull_mode = BaseMaterial3D.CULL_BACK if mesh.name.begins_with("HeroFace_Continuous") else BaseMaterial3D.CULL_DISABLED
			mat.transparency = BaseMaterial3D.TRANSPARENCY_DISABLED
			if "eyebrow" in mesh.name or "short01" in mesh.name:
				mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA_SCISSOR
				mat.alpha_scissor_threshold = 0.35
				mat.albedo_texture = preload("res://assets/characters/shyam_eyebrow003.png") if "eyebrow" in mesh.name else preload("res://assets/characters/shyam_short01_diffuse.png")
				mat.albedo_color = Color.WHITE
			if "t-shirt" in mesh.name:
				mat.albedo_color = shirts[variant % shirts.size()] if crowd else Color("eee8d9")
			elif "pants" in mesh.name:
				mat.albedo_color = trousers[variant % trousers.size()] if crowd else Color("34363b")
			elif "low-poly" in mesh.name:
				mat.albedo_texture = preload("res://assets/characters/shyam_brown_eye.png")
				mat.albedo_color = Color(0.82, 0.76, 0.74) if mesh.name.begins_with("HeroEye") else Color.WHITE
			elif mesh.name == "Shyam" or mesh.name == "Shyam_gltf":
				mat.albedo_texture = preload("res://assets/characters/shyam_young_lightskinned_male_diffuse3.png") if crowd else preload("res://assets/characters/shyam_approved_skin.png")
				mat.albedo_color = (Color(0.77, 0.66, 0.55) if variant % 3 == 0 else Color(0.90, 0.78, 0.66)) if crowd else Color.WHITE
			if not crowd and hero_scene.resource_path != "res://assets/characters/shyam_hero.glb" and ("t-shirt" in mesh.name or "pants" in mesh.name):
				var fabric := ShaderMaterial.new()
				fabric.shader = preload("res://assets/shaders/woven_fabric.gdshader")
				fabric.set_shader_parameter("cloth_color", Color("e6e1d5") if "t-shirt" in mesh.name else Color("36383b"))
				fabric.set_shader_parameter("denim", 1.0 if "pants" in mesh.name else 0.0)
				mesh.set_surface_override_material(surface, fabric)
			else:
				mesh.set_surface_override_material(surface, mat)
	for side in ["l", "r"]:
		if not legacy_model or (not crowd and hero_scene.resource_path.get_file() in ["shyam_hero_v07.glb", "shyam_hero_v08.glb", "shyam_hero_v09.glb"]):
			break
		var attachment := BoneAttachment3D.new()
		attachment.bone_name = "foot_" + side
		skeleton.add_child(attachment)
		var shoe := MeshInstance3D.new()
		var shape := SphereMesh.new()
		shape.radius = 0.5
		shape.height = 1
		shape.radial_segments = 12
		shape.rings = 6
		shoe.mesh = shape
		var mat := StandardMaterial3D.new()
		mat.albedo_color = Color("302d29") if crowd else Color("777a7b")
		mat.roughness = 0.95
		shoe.material_override = mat
		var pos := Vector3(0.18 if side == "l" else -0.18, 0.065, 0.11)
		var rest := skeleton.get_bone_global_rest(bones["foot_" + side])
		shoe.transform = rest.affine_inverse() * Transform3D(Basis.IDENTITY.scaled(Vector3(0.15, 0.12, 0.32)), pos)
		attachment.add_child(shoe)
		if not crowd and hero_scene.resource_path != "res://assets/characters/shyam_hero.glb":
			shoe.visible = false
			var sneaker := Node3D.new()
			sneaker.transform = rest.affine_inverse() * Transform3D(Basis.IDENTITY, pos)
			attachment.add_child(sneaker)
			sneaker_part(sneaker, Vector3(0, -0.035, 0), Vector3(0.155, 0.03, 0.325), Color("d0c8b8"))
			sneaker_part(sneaker, Vector3(0, -0.005, -0.015), Vector3(0.145, 0.09, 0.275), Color("4d5050"))
			sneaker_part(sneaker, Vector3(0, -0.012, 0.106), Vector3(0.145, 0.06, 0.11), Color("c9c3b7"))
			for lace in range(5):
				sneaker_part(sneaker, Vector3(0, 0.037, -0.063 + lace * 0.024), Vector3(0.078, 0.005, 0.007), Color("d7d2c5"))

	if kind == "elder":
		add_turban()
	configure_animations()
	var action_library = preload("res://action_animation.gd").build(self)
	install_mocap_actions(action_library)
	animator.add_animation_library("action", action_library)
	setup_blending()
	setup_head_look()
	if not crowd:
		foot_ik = preload("res://hero_physics.gd").setup_foot_ik(self)
		setup_stubble()
		preload("res://hero_wardrobe.gd").apply(self, outfit)

func install_mocap_actions(library: AnimationLibrary) -> void:
	# Swap the authored keyframe clips for the retargeted motion capture where a clip exists.
	var curl := Quaternion(Vector3.RIGHT, .65)
	for clip_name in animator.get_animation_list():
		if not clip_name.begins_with("Mocap"):
			continue
		var action_name := clip_name.trim_prefix("Mocap")
		var clip: Animation = animator.get_animation(clip_name).duplicate(true)
		if action_name in MOCAP_FISTS:
			for track in range(clip.get_track_count()):
				var bone := str(clip.track_get_path(track).get_subname(0)) if clip.track_get_path(track).get_subname_count() > 0 else ""
				if clip.track_get_type(track) == Animation.TYPE_ROTATION_3D and (bone.begins_with("index_") or bone.begins_with("middle_") or bone.begins_with("ring_") or bone.begins_with("pinky_")):
					for key in range(clip.track_get_key_count(track)):
						var q: Quaternion = clip.track_get_key_value(track, key)
						clip.track_set_key_value(track, key, (q * curl).normalized())
		library.add_animation(action_name, clip)

func has_action(value: String) -> bool:
	return animator != null and animator.has_animation("action/" + value)

func knock_down(impulse: Vector3) -> void:
	# Physics takes the body over (built on first use so idle residents cost nothing).
	if ragdoll == null:
		ragdoll = preload("res://hero_physics.gd").setup_ragdoll(self)
	action = ""
	action_left = 0.0
	action_next = ""
	preload("res://hero_physics.gd").start_ragdoll(self, impulse)

func get_up() -> void:
	preload("res://hero_physics.gd").stop_ragdoll(self)

func apply_outfit(index: int) -> void:
	if crowd:
		return
	preload("res://hero_wardrobe.gd").apply(self, index)

func outfit_name() -> String:
	return preload("res://hero_wardrobe.gd").OUTFITS[outfit].name

func setup_stubble() -> void:
	# A second draw of the skinned face carries the beard overlay; blend shapes are mirrored each frame.
	if face == null or skeleton.find_bone("head") < 0:
		return
	stubble = MeshInstance3D.new()
	stubble.name = "HeroStubble"
	stubble.mesh = face.mesh
	stubble.skin = face.skin
	stubble_material = ShaderMaterial.new()
	stubble_material.shader = preload("res://assets/shaders/stubble.gdshader")
	stubble.material_override = stubble_material
	stubble.visibility_range_end = 30
	face.add_sibling(stubble)
	stubble.transform = face.transform
	stubble.skeleton = stubble.get_path_to(skeleton)

func update_stubble() -> void:
	if stubble == null or not stubble.visible:
		return
	var head := skeleton.find_bone("head")
	var head_world: Transform3D = skeleton.global_transform * skeleton.get_bone_global_pose(head)
	stubble_material.set_shader_parameter("head_inverse", head_world.affine_inverse())
	for i in range(face.mesh.get_blend_shape_count()):
		stubble.set_blend_shape_value(i, face.get_blend_shape_value(i))

func setup_head_look() -> void:
	# Head tracking for people nearby: only when this rig's head bone faces along ±Z.
	var head := skeleton.find_bone("head")
	if head < 0:
		return
	var forward: float = skeleton.get_bone_global_rest(head).basis.z.z
	if absf(forward) < .7:
		return
	look = LookAtModifier3D.new()
	look.bone_name = "head"
	look.forward_axis = SkeletonModifier3D.BONE_AXIS_PLUS_Z if forward > 0 else SkeletonModifier3D.BONE_AXIS_MINUS_Z
	look.primary_rotation_axis = Vector3.AXIS_Y
	look.use_secondary_rotation = true
	look.use_angle_limitation = true
	look.primary_limit_angle = deg_to_rad(120)
	look.primary_damp_threshold = deg_to_rad(70)
	look.secondary_limit_angle = deg_to_rad(50)
	look.secondary_damp_threshold = deg_to_rad(30)
	look.duration = .3
	look.influence = 0.0
	skeleton.add_child(look)

func stop_action(blend := .25) -> void:
	action = ""
	action_left = 0.0
	action_next = ""
	if animation_tree != null:
		animation_tree.active = true
	animator.play("Idle",blend)

func polish_generated_materials() -> void:
	# MPFB exports plain principled materials; keep them but soften specular and fix hair alpha.
	for mesh in model.find_children("*", "MeshInstance3D", true, false):
		mesh.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON
		for surface in range(mesh.mesh.get_surface_count()):
			var original = mesh.get_active_material(surface)
			if not original is StandardMaterial3D:
				continue
			var mat: StandardMaterial3D = original.duplicate()
			mat.metallic = 0.0
			mat.metallic_specular = 0.2
			mat.roughness = maxf(mat.roughness, 0.7)
			var lowered := mesh.name.to_lower()
			if "hair" in lowered or "eyebrow" in lowered or "eyelash" in lowered:
				mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA_SCISSOR
				mat.alpha_scissor_threshold = 0.4
				mat.cull_mode = BaseMaterial3D.CULL_DISABLED
			elif "eye" in lowered:
				mat.roughness = 0.25
				mat.metallic_specular = 0.5
			mesh.set_surface_override_material(surface, mat)

func add_turban() -> void:
	var head_bone := -1
	for bone_name in bones:
		if str(bone_name).to_lower() == "head":
			head_bone = bones[bone_name]
			break
	if head_bone < 0:
		for bone_name in bones:
			if "head" in str(bone_name).to_lower():
				head_bone = bones[bone_name]
				break
	if head_bone < 0:
		return
	var attachment := BoneAttachment3D.new()
	attachment.bone_name = skeleton.get_bone_name(head_bone)
	skeleton.add_child(attachment)
	var rest := skeleton.get_bone_global_rest(head_bone)
	var turban := MeshInstance3D.new()
	var shape := SphereMesh.new()
	shape.radius = 0.5
	shape.height = 1
	shape.radial_segments = 14
	shape.rings = 7
	turban.mesh = shape
	var mat := StandardMaterial3D.new()
	mat.albedo_color = [Color("c2410c"), Color("d9a441"), Color("b64e36"), Color("efe8d6")][variant % 4]
	mat.roughness = 0.9
	turban.material_override = mat
	turban.transform = rest.affine_inverse() * Transform3D(Basis.IDENTITY.scaled(Vector3(0.24, 0.17, 0.25)), Vector3(0, 1.72, 0.0))
	attachment.add_child(turban)

func sneaker_part(parent: Node3D, at: Vector3, dimensions: Vector3, color: Color) -> void:
	var piece := MeshInstance3D.new()
	var sphere := SphereMesh.new()
	sphere.radius = 0.5
	sphere.height = 1.0
	sphere.radial_segments = 20
	sphere.rings = 10
	piece.mesh = sphere
	piece.position = at
	piece.scale = dimensions
	var material := StandardMaterial3D.new()
	material.albedo_color = color
	material.roughness = 0.9
	piece.material_override = material
	parent.add_child(piece)

func configure_animations() -> void:
	animator = model.find_children("*", "AnimationPlayer", true, false)[0]
	if shared_library == null:
		shared_library = AnimationLibrary.new()
		var idle_model = preload("res://assets/characters/shyam_idle.glb").instantiate()
		var idle_player: AnimationPlayer = idle_model.find_children("*", "AnimationPlayer", true, false)[0]
		var run_model = preload("res://assets/characters/shyam_run.glb").instantiate()
		var run_player: AnimationPlayer = run_model.find_children("*", "AnimationPlayer", true, false)[0]
		for clip_name in ["Walk", "Idle", "Run"]:
			var source: Animation = animator.get_animation(clip_name) if clip_name == "Walk" else (idle_player.get_animation(clip_name) if clip_name == "Idle" else run_player.get_animation(clip_name))
			var clip: Animation = source.duplicate(true)
			clip.loop_mode = Animation.LOOP_LINEAR
			# Keep the motion capture in place: physics controls world movement.
			for track in range(clip.get_track_count()):
				clip.track_set_path(track, NodePath(str(clip.track_get_path(track)).replace("Shyam_rig/Skeleton3D:", "Shyam_rig:")))
				if clip.track_get_type(track) == Animation.TYPE_POSITION_3D and str(clip.track_get_path(track)) == "Shyam_rig":
					for key in range(clip.track_get_key_count(track)):
						var pos: Vector3 = clip.track_get_key_value(track, key)
						pos.x = 0
						pos.z = 0
						clip.track_set_key_value(track, key, pos)
			shared_library.add_animation(clip_name, clip)
		idle_model.free()
		run_model.free()
		var mocap_model = preload("res://assets/characters/hero_mocap.glb").instantiate()
		var mocap_player: AnimationPlayer = mocap_model.find_children("*", "AnimationPlayer", true, false)[0]
		for clip_name in mocap_player.get_animation_list():
			var clip: Animation = mocap_player.get_animation(clip_name).duplicate(true)
			clip.loop_mode = Animation.LOOP_LINEAR if clip_name in MOCAP_LOOPS else Animation.LOOP_NONE
			for track in range(clip.get_track_count()):
				var path := clip.track_get_path(track)
				if path.get_subname_count() > 0:
					clip.track_set_path(track, NodePath("Shyam_rig:" + str(path.get_subname(0))))
			shared_library.add_animation("Mocap" + clip_name, clip)
		mocap_model.free()
	for library in animator.get_animation_library_list():
		animator.remove_animation_library(library)
	# Each imported mesh has a different skeleton nesting; resolve it rather than
	# silently animating the armature Node3D instead of its Skeleton3D child.
	var local_library := AnimationLibrary.new()
	var skeleton_path := str(animator.get_node(animator.root_node).get_path_to(skeleton))
	for clip_name in shared_library.get_animation_list():
		var clip: Animation = shared_library.get_animation(clip_name).duplicate(true)
		for track in clip.get_track_count():
			var path := clip.track_get_path(track)
			if path.get_subname_count()>0:
				clip.track_set_path(track,NodePath(skeleton_path+":"+str(path.get_subname(0))))
		local_library.add_animation(clip_name,clip)
	animator.add_animation_library("", local_library)
	animator.play("Idle")
	animator.seek(fmod(variant * 1.23, 8.0), true)

func setup_blending() -> void:
	animation_tree = AnimationTree.new()
	add_child(animation_tree)
	animation_tree.anim_player = animation_tree.get_path_to(animator)
	animation_tree.root_node = animation_tree.get_path_to(animator.get_node(animator.root_node))
	var blend := AnimationNodeBlendSpace1D.new()
	blend.min_space = 0
	blend.max_space = 6.5
	for spec in [["Idle",0.0],["Walk",2.2],["Run",6.5]]:
		var node := AnimationNodeAnimation.new()
		node.animation = spec[0]
		blend.add_blend_point(node,spec[1],-1,spec[0])
	blend.sync = true
	animation_tree.tree_root = blend
	animation_tree.active = true

func play_action(value: String, duration := -1.0, blend := 0.09, then := "") -> void:
	if not animator.has_animation("action/"+value):
		return
	action_next = then
	action = value
	action_left = animator.get_animation("action/"+value).length if duration < 0 else duration
	animation_tree.active = false
	animator.speed_scale = 1.0
	animator.play("action/"+value,blend)

func update_head_look(delta: float) -> void:
	if look == null:
		return
	var valid: bool = look_target != null and is_instance_valid(look_target) and look_target.is_inside_tree()
	if valid:
		var path := look.get_path_to(look_target)
		if path != look_path:
			look_path = path
			look.target_node = path
	look.influence = move_toward(look.influence, 1.0 if valid else 0.0, delta * 2.5)

func _process(delta: float) -> void:
	time += delta
	update_face(delta)
	update_head_look(delta)
	update_stubble()
	preload("res://hero_physics.gd").update_pendulums(self, delta)
	if ragdolling:
		ragdoll_time += delta
		return
	preload("res://hero_physics.gd").update_foot_ik(self, delta, grounded and action == "" and movement_speed < 4.5)
	if action_left > 0:
		action_left -= delta
		if action_left <= 0 and action_next != "":
			# Chained clip, e.g. SitDown flowing into the seated loop.
			var next := action_next
			action_next = ""
			play_action(next, 3600.0, .25)
		return
	if guarding or crouching:
		var pose := "Guard" if guarding else "Crouch"
		if action != pose:
			play_action(pose,0.01)
		return
	if action != "":
		action = ""
		animation_tree.active = true
	locomotion_blend = move_toward(locomotion_blend,movement_speed,delta*12)
	animation_tree.set("parameters/blend_position",locomotion_blend)
